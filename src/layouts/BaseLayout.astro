---
/**
 * Layout dasar untuk seluruh halaman publik.
 *
 * Slot `head` disediakan untuk <SeoHead> yang dipasang di T-201. Sampai itu
 * ada, meta minimal dirender di sini supaya halaman tidak pernah tayang tanpa
 * title dan description (CLAUDE.md aturan 9).
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingWhatsApp from '../components/islands/FloatingWhatsApp';
import SeoHead from '../components/seo/SeoHead.astro';
import { getDictionary, getLocale, htmlLang, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD siap pakai, hasil `graph([...])` dari src/lib/seo/schema.ts. */
  jsonLd?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Padanan bahasa untuk rute DINAMIS yang tidak terdaftar di routes.ts. */
  alternates?: Array<{ locale: Locale; path: string }>;
  /** Kelas tambahan untuk <main>. */
  mainClass?: string;
}

const {
  title,
  description,
  noindex = false,
  jsonLd,
  ogImage,
  ogType,
  alternates,
  mainClass = '',
} = Astro.props as Props;

const locale = getLocale(Astro.url);
const d = getDictionary(locale);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={htmlLang(locale)} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <SeoHead
      title={title}
      description={description}
      locale={locale}
      noindex={noindex}
      jsonLd={jsonLd}
      ogImage={ogImage}
      ogType={ogType}
      alternates={alternates}
    />

    {/* Slot untuk metadata khusus halaman (preload, verifikasi situs). */}
    <slot name="head" />
  </head>

  <body class="bg-surface-base text-brand-900 font-body flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">{d.common.skipToContent}</a>

    <Header locale={locale} currentPath={currentPath} />

    <main id="main" class:list={['flex-1', mainClass]}>
      <slot />
    </main>

    <Footer locale={locale} />

    <FloatingWhatsApp
      client:idle
      label={d.whatsapp.floatingLabel}
      dismissLabel={d.whatsapp.dismiss}
      message={d.whatsapp.defaultMessage}
    />
  </body>
</html>
