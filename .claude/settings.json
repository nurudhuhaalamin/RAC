{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build)",
      "Bash(pnpm check:*)",
      "Bash(pnpm install*)",
      "Bash(node scripts/*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "Bash(gh pr *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(npm view *)",
      "mcp__github__create_pull_request",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler d1 execute * --remote*)",
      "Bash(wrangler d1 migrations apply * --remote*)",
      "Bash(wrangler secret*)",
      "Bash(wrangler kv * --remote*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(curl https://api.cloudflare.com*)",
      "Bash(curl https://*.workers.dev*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-worklog.mjs"
          }
        ]
      }
    ]
  }
}
