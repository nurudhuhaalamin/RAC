---
interface Props {
  id: string;
  name: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  describedBy?: string;
  class?: string;
  [key: string]: unknown;
}
const {
  id,
  name,
  value = '',
  placeholder,
  rows = 4,
  required = false,
  disabled = false,
  invalid = false,
  describedBy,
  class: className = '',
  ...rest
} = Astro.props as Props;
---

<textarea
  id={id}
  name={name}
  rows={rows}
  placeholder={placeholder}
  required={required}
  disabled={disabled}
  aria-invalid={invalid ? 'true' : undefined}
  aria-describedby={describedBy}
  class:list={[
    'font-body text-brand-900 w-full rounded-md border px-3 py-2 text-base',
    'placeholder:text-neutral-400',
    'focus-visible:outline-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2',
    'disabled:bg-surface-subtle disabled:cursor-not-allowed',
    invalid ? 'border-danger border-2' : 'border-border-strong',
    className,
  ]}
  {...rest}>{value}</textarea
>
