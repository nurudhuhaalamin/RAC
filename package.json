{
  "name": "rac-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website Rope Access Center (RAC) — Training Center & Jasa Perawatan Gedung",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev --port 8788",
    "astro": "astro",
    "typecheck": "astro check --minimumseverity error",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:staged": "eslint --fix --no-warn-ignored",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "check:content": "node scripts/check-content.mjs",
    "check:worklog": "node scripts/check-worklog.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/db-migrate-local.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --experimental-strip-types db/seed/index.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/react": "^6.0.2",
    "astro": "^7.2.1",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro-eslint-parser": "^1.2.0",
    "better-sqlite3": "^11.8.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.122.0"
  }
}
