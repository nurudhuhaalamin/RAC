---
/**
 * Pengalih bahasa.
 *
 * Memakai `localizedPath()` dari routes.ts — BUKAN sekadar menambahkan prefix
 * `/en`. Slug diterjemahkan, jadi `/pelatihan/` harus menuju `/en/training/`.
 * Menebak akan menghasilkan tautan ke halaman 404.
 *
 * A-08: wajib ada di header desktop DAN drawer mobile, bukan hanya di footer.
 */
import { LOCALES, getDictionary, localizedPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
  tone?: 'on-light' | 'on-dark';
  class?: string;
}
const { locale, currentPath, tone = 'on-dark', class: className = '' } = Astro.props as Props;
const d = getDictionary(locale);

const labels: Record<Locale, string> = {
  id: d.common.switchToIndonesian,
  en: d.common.switchToEnglish,
};
---

<nav aria-label={d.common.languageSwitcher} class:list={['flex items-center gap-1', className]}>
  {
    LOCALES.map((l) => {
      const isCurrent = l === locale;
      return (
        <a
          href={localizedPath(currentPath, l)}
          hreflang={l}
          lang={l}
          aria-current={isCurrent ? 'true' : undefined}
          class:list={[
            'font-body inline-flex min-h-11 items-center rounded-sm px-2 text-xs font-semibold uppercase',
            'focus-visible:outline-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2',
            tone === 'on-dark'
              ? isCurrent
                ? 'text-neutral-0'
                : 'text-brand-200 hover:text-neutral-0'
              : isCurrent
                ? 'text-brand-900'
                : 'hover:text-brand-900 text-neutral-600',
          ]}
        >
          <span class="sr-only">{labels[l]}</span>
          <span aria-hidden="true">{l.toUpperCase()}</span>
        </a>
      );
    })
  }
</nav>
