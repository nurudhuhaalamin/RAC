---
/** Pembungkus lebar maksimum. Semua seksi memakai ini agar lebar konten konsisten. */
interface Props {
  size?: 'narrow' | 'default' | 'wide' | 'reading';
  as?: 'div' | 'section' | 'article' | 'header' | 'footer' | 'main';
  class?: string;
}
const { size = 'default', as: Tag = 'div', class: className = '' } = Astro.props as Props;

const sizes = {
  narrow: 'max-w-3xl',
  default: 'max-w-7xl',
  wide: 'max-w-[90rem]',
  reading: 'max-w-[68ch]',
} as const;
---

<Tag class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className]}>
  <slot />
</Tag>
