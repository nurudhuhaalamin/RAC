# Template variabel lingkungan — Rope Access Center (RAC)
#
# Salin ke .dev.vars untuk pengembangan lokal:  cp .env.example .dev.vars
# .dev.vars TIDAK di-commit (lihat .gitignore).
# Di produksi, nilai-nilai ini disimpan sebagai Cloudflare Secrets, bukan di file.
#
# JANGAN PERNAH mengisi nilai asli di file ini.

# ── Situs ────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=Rope Access Center

# ── Cloudflare Turnstile (anti-bot pada form lead) ───────────────────────
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Resend (notifikasi lead ke tim sales) ────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# ── Keamanan ─────────────────────────────────────────────────────────────
# Salt untuk hashing IP address. Wajib acak dan panjang.
# IP disimpan sebagai hash, tidak pernah mentah (UU PDP, PLAN Bab 13.3).
IP_HASH_SALT=

# ── Cloudflare API (backup D1 harian, ADR-004) ───────────────────────────
# Lingkupkan seketat mungkin: hanya D1 Read pada satu database.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# ── Analitik (dimuat HANYA setelah consent — PLAN Bab 14.2) ──────────────
# Nilai sebenarnya diambil dari tabel `settings`, bukan hardcode.
# Baris di bawah hanya untuk pengembangan lokal.
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GTM_ID=
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# ── Opsional ─────────────────────────────────────────────────────────────
SENTRY_DSN=
